                "summary": "修改账号",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "账号ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "修改账号参数",
                        "name": "data",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.ModifySysAccountDTO"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "失败响应",
