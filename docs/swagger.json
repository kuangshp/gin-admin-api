        "/api/v1/admin/auth/captcha": {
            "get": {
                "description": "生成图形验证码，返回验证码图片 Base64、验证码 ID 和验证码值",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "认证中心"
                ],
                "summary": "获取图形验证码图片",
                "responses": {
                    "200": {
                        "description": "统一响应，code=0 时 result 为 vo.GetCaptchaVO，code=1 时 result 为 null",
                        "schema": {
                            "$ref": "#/definitions/gin.H"
                        }
                    }
                }
            }
        },
        "/api/v1/admin/auth/captcha/verify": {
            "post": {
                "description": "根据验证码 ID 和验证码值校验图形验证码",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "认证中心"
                ],
                "summary": "验证图形验证码",
                "parameters": [
                    {
                        "description": "验证码参数",
                        "name": "data",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.VerifyCaptchaDTO"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "统一响应，code=0 时 result 为验证码成功，code=1 时 result 为 null",
                        "schema": {
                            "$ref": "#/definitions/gin.H"
                        }
                    }
                }
            }
        },
        "/api/v1/admin/auth/login": {
            "post": {
                "description": "使用账号、邮箱或手机号登录，登录成功后返回账号信息和 token",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "认证中心"
                ],
                "summary": "账号登录",
                "parameters": [
                    {
                        "description": "登录参数",
                        "name": "data",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.AccountLoginDTO"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "统一响应，code=0 时 result 为 vo.AccountLoginVO，code=1 时 result 为 null",
                        "schema": {
                            "$ref": "#/definitions/gin.H"
                        }
                    }
                }
            }
        },
        "/api/v1/admin/auth/logout": {
            "post": {
                "description": "删除当前登录用户的 token 缓存",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "认证中心"
                ],
                "summary": "用户退出登录",
                "parameters": [
                    {
                        "type": "string",
                        "description": "登录 token",
                        "name": "token",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "统一响应，code=0 时 result 为退出登录成功，code=1 时 result 为 null",
                        "schema": {
                            "$ref": "#/definitions/gin.H"
                        }
                    }
                }
            }
        }
