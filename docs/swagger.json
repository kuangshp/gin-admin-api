                    "minItems": 1,
                    "items": {
                        "type": "integer"
                    }
                },
                "sort": {
                    "description": "排序",
                    "type": "integer"
                },
                "status": {
                    "description": "状态1是正常,2是禁用",
                    "type": "integer",
                    "enum": [
                        1,
                        2
                    ]
                }
            }
        },
        "dto.GetSysAccountPageDTO": {
            "type": "object",
