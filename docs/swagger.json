                    "description": "登录密码",
                    "type": "string"
                },
                "username": {
                    "description": "登录帐号",
                    "type": "string"
                }
            }
        },
        "dto.CreateSysRoleDTO": {
            "type": "object",
            "required": [
                "name",
                "resourcesIdList"
            ],
            "properties": {
                "description": {
                    "description": "描述",
                    "type": "string"
